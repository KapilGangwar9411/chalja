{
  "name": "spectrum",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vimeo/player": "^2.26.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "emailjs-com": "^3.2.0",
    "express": "^4.18.2",
    "firebase": "^10.8.0",
    "framer-motion": "^11.5.6",
    "mini-svg-data-uri": "^1.4.4",
    "node-cache": "^5.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.0.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.22.1",
    "react-scripts": "^5.0.1",
    "react-slick": "^0.30.1",
    "sharp": "^0.33.2",
    "slick-carousel": "^1.8.1",
    "spdy": "^4.0.2",
    "tailwind-merge": "^2.2.1",
    "ttf2woff2": "^5.0.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "workbox-webpack-plugin": "^6.5.4"
  },
  "scripts": {
    "start": "set GENERATE_SOURCEMAP=false && react-app-rewired start",
    "build": "set GENERATE_SOURCEMAP=false && npm run optimize-images && react-app-rewired build && npm run postbuild",
    "build:production": "set NODE_ENV=production && set GENERATE_SOURCEMAP=false && cross-env INLINE_RUNTIME_CHUNK=true react-app-rewired build && npm run postbuild",
    "postbuild": "node scripts/compress-assets.js && npx critters build/index.html",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "optimize-images": "mkdir -p scripts && node scripts/optimize-images.js",
    "analyze": "set ANALYZE=true && npm run build:production",
    "serve": "node server.js",
    "serve:prod": "set NODE_ENV=production && node server.js",
    "generate-certs": "openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout server.key -out server.crt -subj \"/CN=localhost\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "globals": {
      "self": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.9",
    "autoprefixer": "^10.4.17",
    "compression-webpack-plugin": "^11.1.0",
    "critters": "^0.0.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.35",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.1",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
